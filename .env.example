# Keep real values outside Git. Passwords are intentionally omitted.
DBAPULSE_SOURCE_CONNECTION=Server=host.docker.internal,1433;Database=master;User Id=sa;Password=<set-outside-source-control>;TrustServerCertificate=True;Encrypt=False;
DBAPULSE_MANAGEMENT_CONNECTION=Server=host.docker.internal,1433;Database=DBA_PULSE;User Id=sa;Password=<set-outside-source-control>;TrustServerCertificate=True;Encrypt=False;
DBAPULSE_API_CONNECTION=Server=host.docker.internal,1433;Database=DBA_PULSE;User Id=sa;Password=<set-outside-source-control>;TrustServerCertificate=True;Encrypt=False;
DBAPULSE_DISPLAY_TIMEZONE=Europe/Istanbul
DBAPULSE_COLLECTION_INTERVAL_MINUTES=5
DBAPULSE_BASELINE_WINDOW_DAYS=30
DBAPULSE_BASELINE_MIN_DAYS=7
DBAPULSE_BASELINE_MIN_SAMPLES=20
DBAPULSE_BASELINE_RECALC_INTERVAL_HOURS=6
DBAPULSE_ANOMALY_RESOLVE_AFTER_SECONDS=900
# Set true for a single smoke-test collection, then run the container again for cycle 2.
DBAPULSE_RUN_ONCE=false
